#!/bin/bash
# Pre-commit hook: go mod tidy check, go vet, staticcheck
# Install via: make install-hooks (or scripts/install-hooks.sh)

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

pass() { echo -e "${GREEN}✓${NC} $1"; }
fail() { echo -e "${RED}✗${NC} $1"; exit 1; }
warn() { echo -e "${YELLOW}⚠${NC} $1"; }
step() { echo -e "${BOLD}→${NC} $1"; }

echo ""
echo -e "${BOLD}Pre-commit checks${NC}"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

# Only run if Go files are staged
STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
if [ -z "$STAGED_GO" ]; then
    echo "No Go files staged — skipping."
    exit 0
fi

# ── 1. go mod tidy ──────────────────────────────────────────────────────────
step "go mod tidy"
go mod tidy
if ! git diff --exit-code go.mod go.sum > /dev/null 2>&1; then
    fail "go.mod/go.sum not tidy. Run 'go mod tidy' and stage the changes."
fi
pass "go.mod tidy"

# ── 2. go vet ───────────────────────────────────────────────────────────────
step "go vet ./..."
if ! go vet ./... 2>&1; then
    fail "go vet found issues"
fi
pass "go vet"

# ── 3. staticcheck ──────────────────────────────────────────────────────────
step "staticcheck"
if ! command -v staticcheck &> /dev/null; then
    warn "staticcheck not installed — skipping."
    warn "Install: go install honnef.co/go/tools/cmd/staticcheck@latest"
else
    # Exclude auto-generated package (generated/) and run all SA + S1 + selected ST checks
    PKGS=$(go list ./... | grep -v 'kas/generated$' | grep -v 'kas/pbschema$')
    CHECKS="all,-ST1000,-ST1003,-ST1020,-ST1021,-ST1022"

    if ! staticcheck -checks "$CHECKS" $PKGS 2>&1; then
        fail "staticcheck found issues"
    fi
    pass "staticcheck"
fi

# ── 4. go build (compile check) ─────────────────────────────────────────────
step "go build (compile check)"
if ! go build -o /dev/null . 2>&1; then
    fail "build failed"
fi
pass "build"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo -e "${GREEN}${BOLD}All checks passed — committing.${NC}"
echo ""
